class Solution {
  public:
    int minMeetingRooms(vector<int> &start, vector<int> &end) {
        int n = start.size();
        sort(start.begin(), start.end());
        sort(end.begin(), end.end());
        int room = 0, ans = 0;
        int i = 0, j = 0;
        while(i < n && j < n) {
            if(start[i] < end[j]) {
                room++;
                ans = max(ans, room);
                i++;
            }
            else {
                room--;
                j++;
            }
        }
        return ans;
    }
};
