class Solution {
public:
    bool isPalindrome(string s) {
        string ans = "";
        for(auto c : s) {
            if(isalnum(c))
                ans.push_back(tolower(c));
        }
        int n = ans.size();
        int left = 0, right = n - 1;
        while(left < right) {
            if(ans[left++] != ans[right--]) return false;
        }
        return true;
    }
};
