class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int n = nums.size();
        int minbest = nums[0];
        int maxbest = nums[0];
        int ans = nums[0];
        for(int i = 1; i < n; i++) {
            int v1 = nums[i];
            int v2 = minbest * nums[i];
            int v3 = maxbest * nums[i];
            minbest = min(v1, min(v2, v3));
            maxbest = max(v1, max(v2, v3));
            ans = max(ans, max(minbest, maxbest));
        }
        return ans;
    }
};
