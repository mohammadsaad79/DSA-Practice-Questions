class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int n = nums.size();
        int left = 0, right = k;
        double sum = 0;
        for(int i = left; i < right; i++) {
            sum += nums[i];
        }
        double ans = sum / k;
        while(right < n) {
            sum += nums[right];
            sum -= nums[left];
            ans = max(ans, sum / k);
            right++;
            left++;
        }
        return ans;
    }
};
