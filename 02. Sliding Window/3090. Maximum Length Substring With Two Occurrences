class Solution {
public:
    int maximumLengthSubstring(string s) {
        int n = s.size();
        int ans = INT_MIN;
        unordered_map<char, int> freq;
        int left = 0, right = 0;
        while(right < n) {
            freq[s[right]]++;
            while(freq[s[right]] > 2) {
                freq[s[left]]--;
                left++;
            }
            ans = max(ans, right - left + 1);
            right++;
        }
        return ans;
    }
};
