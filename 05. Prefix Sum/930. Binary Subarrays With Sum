class Solution {
public:
    int numSubarraysWithSum(vector<int>& nums, int goal) {
        int n = nums.size();
        unordered_map<int, int> freq;
        freq[0] = 1;
        int res = 0;
        int sum = 0;
        for(int i = 0; i < n; i++) {
            sum += nums[i];
            int ques = sum - goal;
            if(freq.find(ques) != freq.end()) {
                res += freq[ques];
            }
            freq[sum]++;
        }
        return res;
    }
};
