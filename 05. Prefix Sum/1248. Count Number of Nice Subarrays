class Solution {
public:
    int numberOfSubarrays(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int, int> freq;
        freq[0] = 1;
        int oddCount = 0;
        int ans = 0;
        for(int i = 0; i < n; i++) {
            if(nums[i] % 2 != 0) {
                oddCount++;
            }
            int ques = oddCount - k;
            if(freq.find(ques) != freq.end()) {
                ans += freq[ques];
            }
            freq[oddCount]++;
        }
        return ans;
    }
};
