class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map<int, int> freq;
        freq[0] = -1;
        int sum = 0;
        for(int i = 0; i < n; i++) {
            sum += nums[i];
            int rem = sum % k;
            if(freq.find(rem) != freq.end()) {
                if(i - freq[rem] >= 2) {
                    return true;
                }
            }
            else {
                freq[rem] = i;
            }
        }
        return false;
    }
};
