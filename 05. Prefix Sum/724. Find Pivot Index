class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int n = nums.size();
        int arrSum = 0;
        for(int i = 0; i < n; i++) {
            arrSum += nums[i];
        }
        int leftSum = 0;
        for(int i = 0; i < n; i++) {
            int rightSum = arrSum - leftSum - nums[i];
            if(leftSum == rightSum) {
                return i;
            }
            leftSum += nums[i];
        }
        return -1;
    }   
};
